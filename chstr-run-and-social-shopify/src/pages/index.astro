---
import { requireSite } from '@/utilities/require-site';
import PageLayout from '@/layouts/PageLayout.astro';
import HeroCollage from '@/features/session-overview/views/components/HeroCollage.astro';
import MondayPlan from '@/features/session-overview/views/components/MondayPlan.astro';
import ActivitiesSection from '@/features/session-overview/views/components/ActivitiesSection.astro';
import GalleryMosaic from '@/features/session-overview/views/components/GalleryMosaic.astro';
import TickerBand from '@/features/site-shell/views/components/TickerBand.astro';
import PanelDivider from '@/features/site-shell/views/components/PanelDivider.astro';
import MerchStrip from '@/features/product-browse/views/components/MerchStrip.astro';
import FaqTeaser from '@/features/faq-browse/views/components/FaqTeaser.astro';
import WaiverCallout from '@/features/waiver-sign/views/components/WaiverCallout.astro';
import SocialBand from '@/features/contact-hub/views/components/SocialBand.astro';
import CartLauncher from '@/features/cart-manage/views/components/CartLauncher.tsx';
import { getProductsServer } from '@/data/Product/get-products-server';
import { getImage } from 'astro:assets';
import { priceSummary } from '@/data/Product/product-display';
import { getLocalMedia, leadMedia } from '@/data/Product/product-media';
import { shopifyImageUrl } from '@/utilities/shopify-image-url';
import { SESSIONS } from '@/domain/session/session-schedule';
import ClubEventsTeaser from '@/features/event-browse/views/components/ClubEventsTeaser.astro';
import WhoToLookFor from '@/features/member-browse/views/components/WhoToLookFor.astro';
import LightsNotice from '@/features/session-overview/views/components/LightsNotice.astro';
import { sessionEventNode } from '@/features/site-seo/utilities/schema-nodes';
import { siteRoot, toAbsolute, withBase } from '@/utilities/with-base';

const eventImage = toAbsolute(requireSite(Astro.site), '/og-default.png');
const products = await Promise.all(
  (await getProductsServer()).map(async (product) => {
    const local = getLocalMedia(product);
    const front = local ? leadMedia(local, product).front : undefined;
    return {
      href: withBase(`/merchandise/${product.handle}/`),
      name: product.title,
      price: priceSummary(product),
      image: front ? (await getImage({ src: front, width: 640 })).src : shopifyImageUrl(product.featuredImage?.url ?? withBase('/og-default.png'), 640, 480),
      ratio: front ? ('square' as const) : ('photo' as const),
    };
  }),
);
---

<PageLayout
  title="Home"
  absoluteTitle="CHSTR Run & Social: Free Monday Run Club in Chester"
  description="CHSTR Run & Social: a free Monday run club in Chester. All people, all paces, all welcome. Mondays 18:30 at The Architect, plus football and netball."
  schema={[
    sessionEventNode({
      origin: siteRoot(requireSite(Astro.site)),
      now: new Date(),
      image: eventImage,
      session: SESSIONS.run,
      id: `${siteRoot(requireSite(Astro.site))}#session-run`,
      url: siteRoot(requireSite(Astro.site)),
      free: true,
      description: 'A free Monday run followed by a social at The Architect, Chester. All people, all paces, all welcome. New runners sign the waiver first, and everyone needs a light on dark nights.',
    }),
  ]}
>
  <CartLauncher slot="actions" client:idle />
  <HeroCollage />
  <TickerBand words={['Run', 'Chat', 'Football', 'Netball', 'Social', 'Free']} />
  <section class="mx-auto max-w-6xl px-6 pt-16"><LightsNotice /></section>
  <MondayPlan />
  <PanelDivider />
  <WhoToLookFor />
  <ActivitiesSection />
  <TickerBand words={['Mondays', '18:30', 'The Architect', 'Chester', 'Always free']} tone="ink" reverse />
  <GalleryMosaic />
  <ClubEventsTeaser now={new Date()} />
  <MerchStrip products={products} />
  <PanelDivider />
  <FaqTeaser />
  <section class="mx-auto max-w-6xl px-6 pb-20"><WaiverCallout /></section>
  <SocialBand />
</PageLayout>
