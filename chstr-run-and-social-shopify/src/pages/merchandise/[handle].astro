---
import PageLayout from '@/layouts/PageLayout.astro';
import CartLauncher from '@/features/cart-manage/views/components/CartLauncher.tsx';
import AddToCartForm from '@/features/product-browse/views/components/AddToCartForm.tsx';
import { getProductsServer } from '@/data/Product/get-products-server';
import { productNode } from '@/features/site-seo/utilities/schema-nodes';
import { productMetaDescription } from '@/features/site-seo/utilities/meta-text';
import { formatMoney } from '@/utilities/format-money';
import { shopifyImageUrl, shopifySrcSet } from '@/utilities/shopify-image-url';

export async function getStaticPaths() {
  const products = await getProductsServer();
  return products.map((product) => ({ params: { handle: product.handle }, props: { product } }));
}

const { product } = Astro.props;
const url = new URL(`/merchandise/${product.handle}/`, Astro.site).href;
const absolute = (path: string) => new URL(path, Astro.site).href;
const [lead, ...rest] = product.images.nodes;
const description = product.description.trim();
const price = product.variants.nodes[0].price.amount;
---

<PageLayout
  title={product.title}
  description={productMetaDescription(product.title, formatMoney(price), description)}
  ogType="product"
  image={lead ? absolute(shopifyImageUrl(lead.url, 1200, 630)) : undefined}
  imageAlt={lead?.altText ?? product.title}
  breadcrumbs={[{ name: 'Merchandise', path: '/merchandise/' }, { name: product.title, path: `/merchandise/${product.handle}/` }]}
  schema={[
    productNode({
      origin: Astro.site!.origin,
      url,
      name: product.title,
      description: description || `Collect the ${product.title} at a Monday run.`,
      images: product.images.nodes.map((image) => absolute(shopifyImageUrl(image.url, 1200))),
      sku: product.handle,
      offers: product.variants.nodes.map((variant) => ({ price: Number(variant.price.amount).toFixed(2), inStock: variant.availableForSale, name: variant.title === 'Default Title' ? undefined : variant.title })),
    }),
  ]}
>
  <CartLauncher slot="actions" client:idle />
  <section class="mx-auto grid max-w-6xl gap-10 px-6 py-16 md:grid-cols-2">
    <div class="flex flex-col gap-4">
      {lead && (
        <img
          src={shopifyImageUrl(lead.url, 900, 900)}
          srcset={shopifySrcSet(lead.url, [450, 900, 1350], true) || undefined}
          sizes="(min-width: 768px) 50vw, 100vw"
          alt={lead.altText ?? product.title}
          width="900"
          height="900"
          fetchpriority="high"
          decoding="sync"
          class="aspect-square w-full rounded-3xl border-4 border-border object-cover"
        />
      )}
      {rest.map((image) => (
        <img
          src={shopifyImageUrl(image.url, 900, 900)}
          srcset={shopifySrcSet(image.url, [450, 900, 1350], true) || undefined}
          sizes="(min-width: 768px) 50vw, 100vw"
          alt={image.altText ?? product.title}
          width="900"
          height="900"
          loading="lazy"
          decoding="async"
          class="aspect-square w-full rounded-3xl border-4 border-border object-cover"
        />
      ))}
    </div>
    <div>
      <a href="/merchandise/" class="font-bold underline">← All merchandise</a>
      <h1 class="mt-4 text-4xl sm:text-5xl">{product.title}</h1>
      <p class="mt-2 font-display text-2xl font-bold tabular-nums">{formatMoney(price)}</p>
      <p class="mt-6 max-w-prose whitespace-pre-line">{description || `Collect the ${product.title} at a Monday run.`}</p>
      <AddToCartForm client:visible name={product.title} variants={product.variants.nodes} />
      <p class="mt-6 text-sm text-muted-foreground">Collect your order at a Monday run. No delivery.</p>
    </div>
  </section>
</PageLayout>
