---
import { requireSite } from '@/utilities/require-site';
import PageLayout from '@/layouts/PageLayout.astro';
import CartLauncher from '@/features/cart-manage/views/components/CartLauncher.tsx';
import ProductCard from '@/features/product-browse/views/components/ProductCard.astro';
import PageBanner from '@/features/site-shell/views/components/PageBanner.astro';
import SizeGuideModal from '@/features/product-browse/views/components/SizeGuideModal.astro';
import PanelDivider from '@/features/site-shell/views/components/PanelDivider.astro';
import { getProductsServer } from '@/data/Product/get-products-server';
import { itemListNode } from '@/features/site-seo/utilities/schema-nodes';
import { toAbsolute, withBase } from '@/utilities/with-base';
import { shopifyImageUrl } from '@/utilities/shopify-image-url';

const products = await getProductsServer();
const url = toAbsolute(requireSite(Astro.site), '/merchandise/');
const absolute = (path: string) => toAbsolute(requireSite(Astro.site), path);
---

<PageLayout
  title="Club Merchandise"
  description="CHSTR Run & Social club merchandise. Pay online, then collect your order at the next Monday run. No delivery and no account needed."
  pageType="CollectionPage"
  breadcrumbs={[{ name: 'Merchandise', path: '/merchandise/' }]}
  schema={products.length === 0 ? [] : [itemListNode(url, products.map((product) => ({ url: absolute(`/merchandise/${product.handle}/`), name: product.title, image: absolute(shopifyImageUrl(product.featuredImage?.url ?? '/og-default.png', 800, 800)) })))]}
>
  <CartLauncher slot="actions" client:idle />
  <PageBanner title="Merchandise" kicker="Wear the crew" tiles={['trainersLaces', 'bubbleCluster', 'wordMondays']} />
  <section class="mx-auto max-w-6xl px-6 py-16">
    <div class="mb-8 flex flex-wrap items-center gap-x-6 gap-y-4">
      <p class="max-w-prose">Pay online, then collect at the next <a class="font-bold underline" href={withBase('/events/')}>Monday run</a>. No delivery, no account needed.</p>
      <SizeGuideModal />
    </div>
    {products.length === 0 ? (
      <div class="rounded-3xl border-4 border-border bg-accent p-8">
        <h2 class="text-3xl">New Merch Is On The Way</h2>
        <p class="mt-3 max-w-prose">Nothing in the shop right now. Follow us on <a class="font-bold underline" href={withBase('/contact/')}>social</a> to hear about the next drop.</p>
      </div>
    ) : (
      <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {products.map((product, index) => <ProductCard product={product} eager={index === 0} reveal={index >= 3} />)}
      </ul>
    )}
  </section>
  <PanelDivider />
</PageLayout>
