---
import { Image } from 'astro:assets';
import PageLayout from '@/layouts/PageLayout.astro';
import CartLauncher from '@/features/cart-manage/views/components/CartLauncher.tsx';
import PageBanner from '@/features/site-shell/views/components/PageBanner.astro';
import PanelDivider from '@/features/site-shell/views/components/PanelDivider.astro';
import SocialBand from '@/features/contact-hub/views/components/SocialBand.astro';
import { allTileIds, getTile } from '@/data/Gallery/gallery-tiles';

// Row-major grid: the first tiles are the ones on screen, so they load eagerly and skip the scroll-reveal (which would wait for JavaScript).
const EAGER_UNTIL = 8;
---

<PageLayout
  title="Photo Gallery"
  description="The CHSTR Run & Social crew in pictures: Monday runs, Thursday football, netball and social nights in Chester. All people, all paces, all welcome."
  pageType="ImageGallery"
  breadcrumbs={[{ name: 'Gallery', path: '/gallery/' }]}
>
  <CartLauncher slot="actions" client:idle />
  <PageBanner title="Gallery" kicker="The crew" tiles={['smiley-crowd', 'sprint-sunrise', 'pint-cheers']} />
  <section class="mx-auto max-w-6xl px-6 py-16">
    <p class="mb-10 max-w-prose text-lg">Runners, footballers, netballers and a lot of good chat. Follow us on social for the latest from each week.</p>
    <ul class="grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-4">
      {allTileIds.map((id, index) => (
        <li data-reveal={index >= EAGER_UNTIL ? 'scale' : undefined} style={`--reveal-delay:${(index % 4) * 80}ms`} class="tilt overflow-hidden rounded-3xl border-4 border-border">
          <Image
            src={getTile(id).image}
            alt={getTile(id).alt}
            widths={[320, 480, 640]}
            sizes="(min-width: 1024px) 23vw, (min-width: 768px) 31vw, 46vw"
            class="aspect-square w-full object-cover"
            loading={index < EAGER_UNTIL ? 'eager' : 'lazy'}
            fetchpriority={index === 0 ? 'high' : 'auto'}
            decoding={index === 0 ? 'sync' : 'async'}
          />
        </li>
      ))}
    </ul>
  </section>
  <PanelDivider />
  <SocialBand />
</PageLayout>
