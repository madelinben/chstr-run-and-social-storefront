---
import { Image } from 'astro:assets';
import AddToCartForm from '@/features/product-browse/views/components/AddToCartForm.tsx';
import { formVariants, optionLabel, priceSummary, pricesVary } from '@/data/Product/product-display';
import { getLocalMedia, leadMedia } from '@/data/Product/product-media';
import { shopifyImageUrl, shopifySrcSet } from '@/utilities/shopify-image-url';
import { withBase } from '@/utilities/with-base';
import type { ShopifyProduct } from '@/services/shopify/products';

interface Props {
  product: ShopifyProduct;
  /** In the opening viewport: load now instead of lazily. */
  eager?: boolean;
  /** The single most important image on the page (LCP candidate): fetched at high priority. */
  priority?: boolean;
  /** Scroll-reveal effect. Off for the first row, which is in the opening viewport. */
  reveal?: boolean;
}
const { product, eager = false, priority = false, reveal = true } = Astro.props;
const href = withBase(`/merchandise/${product.handle}/`);
const local = getLocalMedia(product);
const lead = local ? leadMedia(local, product) : undefined;
const shopifyImage = product.featuredImage;
const sizes = '(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw';
const loading = eager ? 'eager' : 'lazy';
const fetchPriority = priority ? 'high' : 'auto';
---

<li data-reveal={reveal ? true : undefined} class="group relative overflow-hidden rounded-3xl border-4 border-border bg-card">
  <div class="relative block aspect-square overflow-hidden border-b-4 border-border bg-white">
    {lead ? (
      <>
        <Image src={lead.front} alt="" widths={[320, 480, 640]} {sizes} loading={loading} fetchpriority={fetchPriority} decoding={priority ? 'sync' : 'async'} class="size-full object-cover" />
        {/* The back view fades in on hover or keyboard focus. Touch screens simply keep the front. */}
        {lead.back && (
          <Image src={lead.back} alt="" widths={[320, 480, 640]} {sizes} loading={loading} decoding="async" class="absolute inset-0 size-full object-cover opacity-0 transition-opacity duration-300 group-hover:opacity-100 group-focus-within:opacity-100" />
        )}
      </>
    ) : (
      shopifyImage && (
        <img
          src={shopifyImageUrl(shopifyImage.url, 640, 640)}
          srcset={shopifySrcSet(shopifyImage.url, [320, 640, 960], 1) || undefined}
          {sizes}
          alt=""
          width="640"
          height="640"
          loading={loading}
          fetchpriority={fetchPriority}
          decoding={priority ? 'sync' : 'async'}
          class="size-full object-cover"
        />
      )
    )}
  </div>
  <div class="p-5">
    {/* The title link is stretched over the whole card (after:absolute), so there is one named link, not an image link plus a title link. */}
    <h2 class="text-2xl"><a href={href} class="after:absolute after:inset-0">{product.title}</a></h2>
    <p class="mt-1 font-display text-xl font-bold tabular-nums">{priceSummary(product)}</p>
    <div class="relative z-10">
      <AddToCartForm client:visible name={product.title} optionLabel={optionLabel(product)} variants={formVariants(product)} showVariantPrices={pricesVary(product)} />
    </div>
  </div>
</li>
