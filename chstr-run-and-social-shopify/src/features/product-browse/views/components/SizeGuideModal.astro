---
import { sizeGuide } from '@/features/product-browse/config';

interface Props {
  /** Visible text on the button that opens the guide. */
  label?: string;
  class?: string;
}
const { label = 'Size guide', class: className = '' } = Astro.props;
---

<button type="button" data-size-guide-open aria-haspopup="dialog" class={`${className} inline-flex min-h-10 items-center gap-2 rounded-full border-4 border-border bg-card px-5 py-2 font-display font-extrabold uppercase transition-transform hover:-translate-y-0.5 active:scale-[0.96]`}>
  <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M3 17 17 3l4 4L7 21H3z" /><path d="m13 7 2 2M10 10l2 2M7 13l2 2" /></svg>
  {label}
</button>

<!-- Native <dialog>: focus trap, Escape to close and focus return come for free. The table is real text, not an image. -->
<dialog data-size-guide aria-labelledby="size-guide-title" class="m-auto w-[min(32rem,92vw)] rounded-3xl border-4 border-border bg-card p-6 text-foreground backdrop:bg-foreground/60">
  <div class="flex items-start justify-between gap-4">
    <h2 id="size-guide-title" class="text-3xl">Size Guide</h2>
    <form method="dialog"><button class="min-h-10 rounded-full border-4 border-border px-4 font-bold" aria-label="Close size guide">Close</button></form>
  </div>
  <p class="mt-2 text-sm text-muted-foreground">Chest measurement in inches, with the UK dress size where there is one.</p>
  <table class="mt-4 w-full text-left tabular-nums">
    <caption class="sr-only">Size guide: chest measurement in inches and UK dress size</caption>
    <thead>
      <tr class="border-b-4 border-border">
        <th scope="col" class="py-2 pr-4">Size</th>
        <th scope="col" class="py-2 pr-4">Chest</th>
        <th scope="col" class="py-2">UK size</th>
      </tr>
    </thead>
    <tbody>
      {sizeGuide.map((row) => (
        <tr class="border-b border-border/30 last:border-0">
          <th scope="row" class="py-2 pr-4 font-bold">{row.size}</th>
          <td class="py-2 pr-4">{row.chest}</td>
          <td class="py-2">{row.uk || '–'}</td>
        </tr>
      ))}
    </tbody>
  </table>
</dialog>

<script>
  // One tiny script, no framework: open on click, close on a click outside the card.
  const dialog = document.querySelector<HTMLDialogElement>('[data-size-guide]');
  document.querySelectorAll<HTMLButtonElement>('[data-size-guide-open]').forEach((button) => button.addEventListener('click', () => dialog?.showModal()));
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });
</script>
