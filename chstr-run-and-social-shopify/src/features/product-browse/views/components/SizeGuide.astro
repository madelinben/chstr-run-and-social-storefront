---
import { sizeGuide } from '@/features/product-browse/config';
---

<!-- Native <details>: no JavaScript, and the table is real text for search and screen readers. -->
<details class="group mt-6 max-w-md rounded-2xl border-4 border-border bg-card p-4 open:bg-muted">
  <summary class="flex min-h-10 cursor-pointer items-center justify-between gap-4 font-display text-lg font-extrabold uppercase">
    Size guide
    <span aria-hidden="true" class="transition-transform group-open:rotate-45">+</span>
  </summary>
  <table class="mt-3 w-full text-left tabular-nums">
    <caption class="sr-only">Size guide: chest measurement in inches and UK dress size</caption>
    <thead>
      <tr class="border-b-2 border-border">
        <th scope="col" class="py-2 pr-4">Size</th>
        <th scope="col" class="py-2 pr-4">Chest</th>
        <th scope="col" class="py-2">UK size</th>
      </tr>
    </thead>
    <tbody>
      {sizeGuide.map((row) => (
        <tr class="border-b border-border/30 last:border-0">
          <th scope="row" class="py-2 pr-4 font-bold">{row.size}</th>
          <td class="py-2 pr-4">{row.chest}</td>
          <td class="py-2">{row.uk || '–'}</td>
        </tr>
      ))}
    </tbody>
  </table>
</details>
