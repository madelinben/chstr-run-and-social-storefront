---
interface Product {
  href: string;
  name: string;
  price: string;
  image: string;
}
interface Props {
  products: Product[];
}
const { products } = Astro.props;
---

{products.length > 0 && (
  <section class="mx-auto max-w-6xl px-6 py-20">
    <div class="mb-10 flex flex-wrap items-end justify-between gap-4">
      <h2 data-reveal class="text-4xl sm:text-6xl">Wear The Crew</h2>
      <a data-reveal href="/merchandise/" class="min-h-10 rounded-full border-4 border-border bg-accent px-6 py-2 font-display font-extrabold uppercase transition-transform hover:-translate-y-0.5 active:scale-[0.96]">All merchandise</a>
    </div>
    <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {products.slice(0, 3).map((product, index) => (
        <li data-reveal="scale" style={`--reveal-delay:${index * 90}ms`}>
          <a href={product.href} class="tilt group block overflow-hidden rounded-3xl border-4 border-border bg-card">
            <img src={product.image} alt="" width="640" height="640" loading="lazy" decoding="async" class="aspect-square w-full border-b-4 border-border object-cover transition-transform duration-500 group-hover:scale-105" />
            <span class="flex items-baseline justify-between gap-3 p-5">
              <span class="font-display text-xl font-extrabold uppercase">{product.name}</span>
              <span class="font-display text-xl font-bold tabular-nums">{product.price}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
    <p data-reveal class="mt-6 text-sm">Pay online, then collect at a Monday run. No delivery, no account.</p>
  </section>
)}
