---
import { socialLinks } from '@/data/Content/settings';
import { Image } from 'astro:assets';
import { galleryTiles, getTile } from '@/data/Gallery/gallery-tiles';
const instagram = socialLinks.instagram;
---

<section class="border-y-4 border-border bg-foreground py-20 text-background">
  <div class="mx-auto max-w-6xl px-6">
    <h2 data-reveal class="mb-3 text-4xl text-accent sm:text-6xl">The Crew</h2>
    <p data-reveal class="mb-10 max-w-prose text-lg">Runners, footballers, netballers and a lot of good chat. This is what a CHSTR week looks like.</p>
    <ul class="columns-2 gap-4 md:columns-3">
      {galleryTiles.map((id, index) => (
        <li data-reveal="scale" style={`--reveal-delay:${(index % 3) * 90}ms`} class="tilt mb-4 break-inside-avoid overflow-hidden rounded-3xl border-4 border-card">
          <Image src={getTile(id).image} alt={getTile(id).alt} widths={[320, 480, 640]} sizes="(min-width: 768px) 30vw, 46vw" class="h-auto w-full" />
        </li>
      ))}
    </ul>
    {instagram && (
      <p data-reveal class="mt-8 text-lg">
        More from the week on <a class="font-bold text-accent underline" href={instagram} rel="noopener">Instagram</a>.
      </p>
    )}
  </div>
</section>
