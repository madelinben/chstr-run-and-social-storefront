---
import { Image } from 'astro:assets';
import { getTile } from '@/data/Gallery/gallery-tiles';
import { ROUTE_NOTE } from '@/data/Content/settings';
import { mondaySteps } from '@/features/session-overview/config';
---

<section class="mx-auto max-w-6xl px-6 section-y">
  <h2 data-reveal class="mb-3 text-4xl sm:text-6xl">How A Monday Works</h2>
  <p data-reveal class="mb-12 max-w-prose text-lg">Three simple steps, every week. No sign-up, no fee, no pressure.</p>
  <ol class="grid gap-8 md:grid-cols-3">
    {mondaySteps.map((step, index) => (
      <li data-reveal={index === 1 ? 'scale' : index === 0 ? 'left' : 'right'} class="tilt group relative rounded-3xl border-4 border-border bg-card p-4 pt-12">
        <span class="absolute -top-6 left-6 grid size-14 place-items-center rounded-full border-4 border-border bg-accent font-display text-2xl font-black" aria-hidden="true">{index + 1}</span>
        <div class="overflow-hidden rounded-2xl border-4 border-border">
          <Image src={getTile(step.tile).image} alt={getTile(step.tile).alt} widths={[320, 480, 640]} sizes="(min-width: 768px) 30vw, 90vw" class="aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover:scale-105" />
        </div>
        <h3 class="mt-4 text-2xl">{step.title}</h3>
        <p class="mt-2 text-pretty">{step.text}</p>
      </li>
    ))}
  </ol>
  <aside data-reveal class="mt-10 flex items-center gap-4 rounded-3xl border-4 border-border bg-accent p-5 text-accent-foreground sm:p-6">
    <svg viewBox="0 0 48 48" width="48" height="48" aria-hidden="true" class="shrink-0"><path d="M8 38c10-4 6-14 14-16s10 6 18-10" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" /><circle cx="8" cy="38" r="4" fill="currentColor" /><circle cx="40" cy="12" r="4" fill="currentColor" /></svg>
    <div>
      <h3 class="text-2xl">A New Route Most Weeks</h3>
      <p class="mt-1 max-w-prose text-lg">{ROUTE_NOTE}</p>
    </div>
  </aside>
</section>
