---
import { Image } from 'astro:assets';
import { tiles } from '@/data/Gallery/gallery-tiles';
import { activities } from '@/features/session-overview/config';
---

<section class="mx-auto max-w-6xl px-6 py-20">
  <h2 data-reveal class="mb-10 text-4xl sm:text-6xl">More Than A Run</h2>
  <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
    {activities.map((activity, index) => (
      <li data-reveal="scale" style={`--reveal-delay:${index * 90}ms`} class={`${activity.color} tilt group overflow-hidden rounded-3xl border-4 border-border`}>
        <Image src={tiles[activity.tile].image} alt={tiles[activity.tile].alt} widths={[320, 480]} sizes="(min-width: 1024px) 22vw, (min-width: 640px) 45vw, 90vw" class="aspect-square w-full border-b-4 border-border object-cover transition-transform duration-500 group-hover:scale-105" />
        <div class="p-5">
          <h3 class="text-2xl">{activity.name}</h3>
          <p class="mt-1">{activity.note}</p>
        </div>
      </li>
    ))}
  </ul>
</section>
