---
import { getCollection } from 'astro:content';
import { withBase, withBaseInHtml } from '@/utilities/with-base';

const entries = (await getCollection('faqs')).sort((a, b) => a.data.position - b.data.position).slice(0, 3);
const items = entries.map((entry) => ({ entry, html: withBaseInHtml(entry.rendered?.html ?? '') }));
---

{items.length > 0 && (
  <section class="mx-auto grid max-w-6xl gap-10 px-6 py-20 lg:grid-cols-[1fr_1.4fr]">
    <div>
      <h2 data-reveal class="text-4xl sm:text-6xl">Quick Answers</h2>
      <p data-reveal class="mt-4 max-w-prose text-lg">New here? Start with these, or read them all.</p>
      <a data-reveal href={withBase('/faqs/')} class="mt-6 inline-flex min-h-10 items-center rounded-full border-4 border-border bg-card px-6 py-2 font-display font-extrabold uppercase transition-transform hover:-translate-y-0.5 active:scale-[0.96]">All FAQs</a>
    </div>
    <div class="flex flex-col gap-3">
      {items.map(({ entry, html }) => (
        <details data-reveal="right" class="group rounded-2xl border-4 border-border bg-card p-4 open:bg-accent">
          <summary class="flex min-h-10 cursor-pointer items-center justify-between gap-4 font-display text-xl font-semibold">
            {entry.data.question}
            <span aria-hidden="true" class="transition-transform group-open:rotate-45">+</span>
          </summary>
          <div class="mt-3 text-pretty" set:html={html} />
        </details>
      ))}
    </div>
  </section>
)}
