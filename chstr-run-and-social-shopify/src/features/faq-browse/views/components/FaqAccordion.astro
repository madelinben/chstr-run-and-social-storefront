---
import { getCollection, render } from 'astro:content';

const entries = (await getCollection('faqs')).sort((a, b) => a.data.position - b.data.position);
const items = await Promise.all(entries.map(async (entry) => ({ entry, Content: (await render(entry)).Content })));
---

{items.length === 0 ? (
  <p>No questions yet. <a class="underline" href="/contact/">Ask us anything</a>.</p>
) : (
  <div class="flex flex-col gap-3">
    {items.map(({ entry, Content }) => (
      <details data-reveal class="group rounded-2xl border-4 border-border bg-card p-4 open:bg-accent">
        <summary class="flex min-h-10 cursor-pointer items-center justify-between gap-4 font-display text-xl font-semibold">
          {entry.data.question}
          <span aria-hidden="true" class="transition-transform group-open:rotate-45">+</span>
        </summary>
        <div class="mt-3 text-pretty"><Content /></div>
      </details>
    ))}
  </div>
)}
