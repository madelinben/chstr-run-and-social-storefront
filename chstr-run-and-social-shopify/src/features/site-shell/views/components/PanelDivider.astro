---
const bars = ['bg-foreground', 'bg-accent', 'bg-card', 'bg-foreground', 'bg-accent', 'bg-secondary', 'bg-foreground', 'bg-accent'];
---

<div aria-hidden="true" data-panel-bars class="flex h-16 w-full overflow-hidden border-y-4 border-border sm:h-24">
  {bars.map((color) => <div data-bar class={`${color} flex-1 border-r-4 border-border last:border-r-0`} />)}
</div>
