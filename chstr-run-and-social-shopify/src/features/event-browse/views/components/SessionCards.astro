---
import { SESSIONS, nextSessionStart, sessionEnd, type Session, type SessionId } from '@/domain/session/session-schedule';
import { sessionCopy } from '@/features/event-browse/config';
import { ROUTE_NOTE } from '@/utilities/brand';
import { googleCalendarUrl, locationText } from '@/features/event-browse/utilities/calendar';
import { formatSessionDay, formatSessionTime } from '@/features/event-browse/utilities/format-session';

interface Props {
  now: Date;
}
const { now } = Astro.props;

const mapUrl = (query: string) => `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(query)}`;
const ids = ['run', 'football', 'netball'] as const satisfies readonly SessionId[];
const sessions = ids.map((id) => {
  const session: Session = SESSIONS[id];
  const start = nextSessionStart(now, session);
  const end = sessionEnd(start, session);
  const copy = sessionCopy[id];
  return {
    session,
    copy,
    start,
    time: end ? `${formatSessionTime(start)} to ${formatSessionTime(end)}` : formatSessionTime(start),
    calendarUrl: googleCalendarUrl(now, { session, description: copy.calendar, url: '' }),
  };
});
const buttonClass = 'min-h-10 rounded-full border-4 border-border px-5 py-2 font-display font-extrabold uppercase transition-transform hover:-translate-y-0.5 active:scale-[0.96]';
---

<ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
  {sessions.map(({ session, copy, start, time, calendarUrl }) => (
    <li class="flex flex-col rounded-3xl border-4 border-border bg-card p-6">
      <p class="font-display text-sm font-bold uppercase tracking-[0.25em] text-muted-foreground">Every {session.dayName}{session.bookingUrl ? ' · book online' : ''}</p>
      <h2 class="mt-1 text-3xl">{copy.title}</h2>
      <p class="mt-3 font-display text-4xl font-black tabular-nums">{time}</p>
      <p class="mt-1 text-sm text-muted-foreground">Next: <time datetime={start}>{formatSessionDay(start)}</time></p>
      <p class="mt-4 font-bold">{session.venueName}</p>
      <p>{locationText(session).replace(`${session.venueName}, `, '')}</p>
      <p class="mt-3 text-pretty">{copy.blurb}</p>
      {session.id === 'run' && <p class="mt-3 rounded-2xl bg-accent p-3 font-semibold text-accent-foreground">{ROUTE_NOTE}</p>}
      <div class="mt-auto flex flex-wrap gap-3 pt-6">
        {session.bookingUrl && <a href={session.bookingUrl} rel="noopener" class={`${buttonClass} bg-accent`}>Book online</a>}
        <a href={mapUrl(locationText(session))} rel="noopener" class={`${buttonClass} ${session.bookingUrl ? 'bg-card' : 'bg-accent'}`}>Directions</a>
        <a href={calendarUrl} rel="noopener" class={`${buttonClass} bg-card`}>Add to calendar</a>
      </div>
    </li>
  ))}
</ul>
