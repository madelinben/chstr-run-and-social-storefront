---
import { Image } from 'astro:assets';
import { getTile } from '@/data/Gallery/gallery-tiles';
import type { ClubEvent } from '@/data/Event/club-events';
import { formatEventDateShort } from '@/domain/event/club-event-timing';
import { withBase } from '@/utilities/with-base';

interface Props {
  event: ClubEvent;
  upcoming: boolean;
  /** Heading level for the card title. */
  headingLevel?: 'h2' | 'h3';
  /** In the opening viewport: load the picture now instead of lazily. */
  eager?: boolean;
}
const { event, upcoming, headingLevel: Heading = 'h3', eager = false } = Astro.props;
const cover = getTile(event.gallery[0]);
---

<li data-reveal={eager ? undefined : 'scale'} class="tilt group relative flex flex-col overflow-hidden rounded-3xl border-4 border-border bg-card">
  <div class="overflow-hidden border-b-4 border-border">
    <Image src={cover.image} alt="" widths={[320, 480, 640]} sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 90vw" loading={eager ? 'eager' : 'lazy'} decoding={eager ? 'sync' : 'async'} class="aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover:scale-105" />
  </div>
  <div class="flex flex-1 flex-col p-5">
    <p class="flex flex-wrap items-center gap-2 text-sm font-bold uppercase tracking-widest text-muted-foreground">
      <time datetime={event.date}>{formatEventDateShort(event.date)}</time>
      {upcoming && <span class="rounded-full border-2 border-border bg-accent px-2 py-0.5 text-accent-foreground">Coming up</span>}
    </p>
    {/* One named link, stretched over the whole card. */}
    <Heading class="mt-1 text-2xl"><a href={withBase(`/events/${event.slug}/`)} class="after:absolute after:inset-0">{event.title}</a></Heading>
    <p class="mt-2 text-pretty">{event.summary}</p>
    <p aria-hidden="true" class="mt-auto pt-4 font-bold underline">{upcoming ? 'Details' : 'See the photos'} →</p>
  </div>
</li>
