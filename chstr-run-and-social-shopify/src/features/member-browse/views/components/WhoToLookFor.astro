---
import LeaderCards from '@/features/member-browse/views/components/LeaderCards.astro';
import { withBase } from '@/utilities/with-base';
---

<section class="mx-auto max-w-6xl px-6 py-20">
  <h2 data-reveal class="mb-3 text-4xl sm:text-6xl">Who To Look For</h2>
  <p data-reveal class="mb-10 max-w-prose text-lg">First time? Come and say hello to the crew. They will make sure you know a few faces before the run even starts.</p>
  <LeaderCards headingLevel="h3" />
  <p data-reveal class="mt-8"><a class="inline-flex min-h-10 items-center rounded-full border-4 border-border bg-accent px-6 py-2 font-display font-extrabold uppercase transition-transform hover:-translate-y-0.5 active:scale-[0.96]" href={withBase('/members/')}>Meet the crew and local legends</a></p>
</section>
