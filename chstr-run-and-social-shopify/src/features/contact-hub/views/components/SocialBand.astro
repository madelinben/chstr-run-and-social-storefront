---
import WhatsAppJoin from '@/features/contact-hub/views/components/WhatsAppJoin.astro';
import { withBase } from '@/utilities/with-base';
const links = [
  import.meta.env.PUBLIC_INSTAGRAM_URL && { label: 'Instagram', href: import.meta.env.PUBLIC_INSTAGRAM_URL, tone: 'bg-accent', path: 'M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5Zm0 2a3 3 0 0 0-3 3v10a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V7a3 3 0 0 0-3-3H7Zm5 3.5a4.5 4.5 0 1 1 0 9 4.5 4.5 0 0 1 0-9Zm0 2a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5Zm5.2-3.2a1.1 1.1 0 1 1 0 2.2 1.1 1.1 0 0 1 0-2.2Z' },
  import.meta.env.PUBLIC_FACEBOOK_URL && { label: 'Facebook', href: import.meta.env.PUBLIC_FACEBOOK_URL, tone: 'bg-card', path: 'M13.5 22v-8.2h2.8l.5-3.4h-3.3V8.3c0-1 .3-1.7 1.7-1.7H17V3.6c-.3 0-1.3-.1-2.5-.1-2.5 0-4.2 1.5-4.2 4.3v2.6H7.5v3.4h2.8V22h3.2Z' },
  import.meta.env.PUBLIC_WHATSAPP_NUMBER && { label: 'WhatsApp', href: `https://wa.me/${import.meta.env.PUBLIC_WHATSAPP_NUMBER}`, tone: 'bg-secondary', path: 'M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.2 14.1c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.3-.7-2.8-1.2-4.6-4-4.7-4.2-.1-.2-1.1-1.5-1.1-2.8s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.4 0 .5l-.3.5-.4.4c-.1.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.3 2.4 1.5.3.1.5.1.6-.1l.9-1.1c.2-.3.4-.2.6-.1l1.9.9c.3.1.5.2.5.3.1.1.1.6-.1 1.2Z' },
].filter(Boolean);
---

<section class="mx-auto max-w-6xl px-6 py-20">
  <div data-reveal class="rounded-[2.5rem] border-4 border-border bg-foreground p-8 text-background sm:p-12">
    <h2 class="text-4xl text-accent sm:text-6xl">Join The Crew</h2>
    <p class="mt-3 max-w-prose text-lg">See what the week looks like, find out about socials and say hello. Come along on Monday, no need to message first.</p>
    <ul class="mt-8 flex flex-wrap gap-3">
      {links.map((link) => (
        <li>
          <a href={link.href} rel="noopener" class={`${link.tone} inline-flex min-h-10 items-center gap-3 rounded-full border-4 border-border px-6 py-3 font-display text-lg font-extrabold uppercase text-foreground transition-transform hover:-translate-y-0.5 active:scale-[0.96]`}>
            <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" fill="currentColor"><path d={link.path} /></svg>
            {link.label}
          </a>
        </li>
      ))}
      <li><WhatsAppJoin tone="outline" /></li>
      <li>
        <a href={withBase('/contact/')} class="inline-flex min-h-10 items-center rounded-full border-4 border-card px-6 py-3 font-display text-lg font-extrabold uppercase transition-transform hover:-translate-y-0.5 active:scale-[0.96]">Contact us</a>
      </li>
    </ul>
  </div>
</section>
