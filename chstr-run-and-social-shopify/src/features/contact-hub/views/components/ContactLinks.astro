---
import { socialLinks } from '@/data/Content/settings';
const email = socialLinks.email;
const whatsappNumber = socialLinks.whatsappNumber;
const links = [
  socialLinks.whatsappGroup && { label: 'WhatsApp group', detail: 'Join the club chat', href: socialLinks.whatsappGroup, color: 'bg-success text-success-foreground' },
  email && { label: 'Email', detail: email, href: `mailto:${email}`, color: 'bg-accent' },
  whatsappNumber && { label: 'WhatsApp', detail: 'Message us', href: `https://wa.me/${whatsappNumber}`, color: 'bg-success text-success-foreground' },
  socialLinks.instagram && { label: 'Instagram', detail: 'Follow along', href: socialLinks.instagram, color: 'bg-primary text-primary-foreground' },
  socialLinks.facebook && { label: 'Facebook', detail: 'Join the group', href: socialLinks.facebook, color: 'bg-secondary' },
].filter((link) => typeof link === 'object');
---

{links.length === 0 ? (
  <p>Contact details are coming soon. Find us at The Architect on Monday at 18:30.</p>
) : (
  <ul class="grid gap-4 sm:grid-cols-2">
    {links.map((link) => (
      <li data-reveal>
        <a href={link.href} rel="noopener" class={`${link.color} flex min-h-10 flex-col rounded-3xl border-4 border-border p-6 press`}>
          <span class="font-display text-2xl font-bold">{link.label}</span>
          <span class="break-words">{link.detail}</span>
        </a>
      </li>
    ))}
  </ul>
)}
