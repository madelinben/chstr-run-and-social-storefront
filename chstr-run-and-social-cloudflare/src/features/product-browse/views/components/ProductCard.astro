---
import AddToCartForm from '@/features/product-browse/views/components/AddToCartForm.tsx';
import { formatPounds } from '@/utilities/format-pounds';

interface Props {
  slug: string;
  name: string;
  pricePence: number;
  sizes: readonly string[];
  image: string;
  eager?: boolean;
}
const { slug, name, pricePence, sizes, image, eager = false } = Astro.props;
---

<li data-reveal class="overflow-hidden rounded-3xl border-4 border-border bg-card">
  <a href={`/merchandise/${slug}/`} class="block" tabindex="-1" aria-hidden="true">
    <img src={image} alt="" width="800" height="800" loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} decoding={eager ? 'sync' : 'async'} class="aspect-square w-full border-b-4 border-border object-cover" />
  </a>
  <div class="p-5">
    <h2 class="text-2xl"><a href={`/merchandise/${slug}/`}>{name}</a></h2>
    <p class="mt-1 font-display text-xl font-bold tabular-nums">{formatPounds(pricePence)}</p>
    <AddToCartForm client:visible productSlug={slug} name={name} unitPricePence={pricePence} sizes={sizes} />
  </div>
</li>
